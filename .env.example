GESTOPAGO_AUTH_URL=https://gestopago.portalventas.net/
GESTOPAGO_AUTH_ID_DISTRIBUIDOR=83
GESTOPAGO_AUTH_CODIGO_DISPOSITIVO=replace-with-device-code
GESTOPAGO_AUTH_PASSWORD=replace-with-service-password
# Opcionales: cron de resincronizacion del catalogo ("-" la desactiva), TTL de Redis y timeouts
GESTOPAGO_PRODUCTOS_SYNC_CRON=-
GESTOPAGO_PRODUCTOS_CACHE_TTL_SECONDS=3600
GESTOPAGO_CONNECT_TIMEOUT_MS=5000
GESTOPAGO_READ_TIMEOUT_MS=30000

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/database
SPRING_DATASOURCE_USERNAME=replace-with-database-user
SPRING_DATASOURCE_PASSWORD=replace-with-database-password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_TIMEOUT=5s
REDIS_CONNECT_TIMEOUT=10s

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
