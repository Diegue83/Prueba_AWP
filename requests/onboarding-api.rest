@baseUrl = http://localhost:8080
@correoPrueba = zayda.rest@example.com
@contrasenaPrueba = Segura123
@curpPrueba = VAVZ950312MGTRRY07
@rfcPrueba = VAVZ950312AB1
@personaPrueba = Prueba-{{$guid}}

### 1. Crear cliente (público; usar un CURP/RFC/correo no registrados)
# @name crearCliente
POST {{baseUrl}}/clientes
Content-Type: application/json

{
  "nombre": "Zayda",
  "apellidoPaterno": "Vargas",
  "apellidoMaterno": "Vargas",
  "fechaNacimiento": "1995-03-12",
  "curp": "{{curpPrueba}}",
  "rfc": "{{rfcPrueba}}",
  "sexo": "M",
  "nacionalidad": "Mexicana",
  "estadoCivil": "S",
  "correo": "{{correoPrueba}}",
  "telefonoMovil": "4181234567",
  "domicilio": {
    "calle": "Av. Hidalgo",
    "numeroExterior": "12",
    "colonia": "Centro",
    "municipio": "Dolores Hidalgo",
    "estado": "Guanajuato",
    "codigoPostal": "37800",
    "pais": "Mexico"
  },
  "ocupacion": "Ingeniera",
  "empresa": "Empresa REST",
  "ingresoMensual": 15000.50,
  "contrasena": "{{contrasenaPrueba}}"
}

> {% client.test("POST /clientes crea un cliente", function() { client.assert(response.status === 201, "Esperado HTTP 201"); }); %}

### 2. Iniciar sesión para obtener el token de las rutas protegidas
# @name iniciarSesion
POST {{baseUrl}}/login
Content-Type: application/json

{
  "correo": "{{correoPrueba}}",
  "contrasena": "{{contrasenaPrueba}}"
}

> {% client.test("POST /login autentica el cliente", function() { client.assert(response.status === 200, "Esperado HTTP 200"); client.assert(!!response.body.datos.token, "La respuesta debe incluir el token"); }); %}

### 3. Consultar clientes combinando criterios opcionales
# @name consultarClientes
POST {{baseUrl}}/clientes/consulta
Authorization: Bearer {{iniciarSesion.response.body.datos.token}}
Content-Type: application/json

{
  "correo": "{{correoPrueba}}",
  "activo": true
}

> {% client.test("POST /clientes/consulta encuentra los criterios", function() { client.assert(response.status === 200, "Esperado HTTP 200"); }); %}

